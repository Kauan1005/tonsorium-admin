# Cabeçalhos de segurança (Netlify / Cloudflare Pages leem este arquivo).
# Content-Security-Policy: o painel só executa scripts do próprio endereço e só
# conversa com o Supabase. 'unsafe-eval', 'wasm-unsafe-eval' e blob: são
# exigidos pelos conversores de foto HEIC (heic2any) e de vídeo (ffmpeg), que
# rodam no navegador. Mantenha igual ao vercel.json.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://*.supabase.co https://*.googleusercontent.com; media-src 'self' blob: https://*.supabase.co; connect-src 'self' blob: data: https://*.supabase.co wss://*.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Robots-Tag: noindex, nofollow
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
